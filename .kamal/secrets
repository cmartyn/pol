# Secrets referenced by config/deploy.yml (registry/password, env/secret,
# accessories/*/env/secret). Everything here is a lookup — the values live in
# the macOS keychain (put there once by the deploy setup) and in
# config/master.key, which is gitignored. DO NOT ENTER RAW CREDENTIALS HERE —
# this file is committed.
#
# To (re)create the keychain items:
#   security add-generic-password -a pol -s pol-do-registry-user  -w <DO account email>
#   security add-generic-password -a pol -s pol-do-registry-token -w <DO registry API token>
#   security add-generic-password -a pol -s pol-db-production     -w <random password>

RAILS_MASTER_KEY=$(cat config/master.key)

KAMAL_REGISTRY_USERNAME=$(security find-generic-password -a pol -s pol-do-registry-user -w)
KAMAL_REGISTRY_PASSWORD=$(security find-generic-password -a pol -s pol-do-registry-token -w)

# One password, two names: the app's database.yml reads POL_DATABASE_PASSWORD,
# the postgres image expects POSTGRES_PASSWORD. Both come from the same
# keychain item so they cannot drift.
POL_DATABASE_PASSWORD=$(security find-generic-password -a pol -s pol-db-production -w)
POSTGRES_PASSWORD=$(security find-generic-password -a pol -s pol-db-production -w)
