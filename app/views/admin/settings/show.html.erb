<% content_for :title, "Settings · Admin · Pol" %>

<h1 class="font-serif text-2xl font-semibold text-slate-900">Settings</h1>
<p class="mt-1 text-sm text-slate-600">The agent newsroom's kill switch.</p>

<section class="mt-6 max-w-xl rounded-lg border border-slate-200 bg-white p-5" data-testid="admin-kill-switch-panel">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div>
      <p class="text-xs uppercase tracking-wide text-slate-400">Stored value</p>
      <p class="mt-1 font-medium text-slate-900" data-testid="admin-kill-switch-stored"><%= @kill_switch.stored_label %></p>
    </div>
    <div>
      <p class="text-xs uppercase tracking-wide text-slate-400">ENV override</p>
      <p class="mt-1 font-medium <%= @kill_switch.env_override? ? "text-red-700" : "text-slate-900" %>" data-testid="admin-kill-switch-env">
        <% if @kill_switch.env_override? %>
          Present (<code><%= Admin::KillSwitchStatus::ENV_VAR %></code> is set)
        <% else %>
          Not set
        <% end %>
      </p>
    </div>
    <div>
      <p class="text-xs uppercase tracking-wide text-slate-400">Effective</p>
      <p class="mt-1 font-semibold <%= @kill_switch.effective? ? "text-green-700" : "text-red-700" %>" data-testid="admin-kill-switch-effective">
        <%= @kill_switch.effective? ? "Agents ON" : "Agents OFF" %>
      </p>
    </div>
  </div>

  <div class="mt-5 border-t border-slate-200 pt-4">
    <% if @kill_switch.env_override? %>
      <p class="text-sm text-slate-500" data-testid="admin-kill-switch-env-explanation">
        <code><%= Admin::KillSwitchStatus::ENV_VAR %></code> is set in the environment, which forces agents off regardless of the
        stored value. The toggle below is disabled until that environment variable is removed.
      </p>
      <button type="button" disabled class="mt-3 cursor-not-allowed rounded-md bg-slate-200 px-4 py-2 text-sm font-medium text-slate-500" data-testid="admin-kill-switch-toggle-disabled">
        Toggle unavailable — ENV override active
      </button>
    <% else %>
      <%= button_to (@kill_switch.effective? ? "Turn agents off" : "Turn agents on"), admin_settings_path, method: :patch,
            class: "rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700",
            data: { testid: "admin-kill-switch-toggle" } %>
    <% end %>
  </div>
</section>
