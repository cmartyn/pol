<% content_for :title, "Subscribers · Admin · 535" %>

<h1 class="font-serif text-2xl font-semibold text-slate-900">Subscribers</h1>
<p class="mt-1 text-sm text-slate-600">Addresses that receive dispatch email, and the ones that have left or bounced.</p>

<dl class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3" data-testid="admin-subscriber-counts">
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Subscribed</dt>
    <dd class="mt-1 text-3xl font-semibold text-slate-900" data-testid="admin-subscribers-subscribed-count"><%= @subscribed_count %></dd>
  </div>
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Unsubscribed</dt>
    <dd class="mt-1 text-3xl font-semibold text-slate-900" data-testid="admin-subscribers-unsubscribed-count"><%= @unsubscribed_count %></dd>
  </div>
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Suppressed</dt>
    <dd class="mt-1 text-3xl font-semibold text-slate-900" data-testid="admin-subscribers-suppressed-count"><%= @suppressed_count %></dd>
  </div>
</dl>

<%= form_with url: admin_subscribers_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3 rounded-lg border border-slate-200 bg-white p-4", data: { testid: "admin-subscriber-filters" } do %>
  <div class="min-w-0 flex-1">
    <label class="block text-xs font-medium text-slate-500" for="q">Email</label>
    <input type="search" name="q" id="q" value="<%= @query %>" placeholder="name@example.com" class="mt-1 w-full max-w-sm rounded-md border-slate-300 text-sm">
  </div>
  <div>
    <label class="block text-xs font-medium text-slate-500" for="status">Status</label>
    <select name="status" id="status" class="mt-1 rounded-md border-slate-300 text-sm">
      <%= options_for_select([
        [ "Subscribed", "subscribed" ],
        [ "Unsubscribed", "unsubscribed" ],
        [ "Suppressed", "suppressed" ],
        [ "All statuses", "all" ]
      ], @status) %>
    </select>
  </div>
  <button type="submit" class="rounded-md bg-slate-100 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200">Filter</button>
  <%= link_to "Reset", admin_subscribers_path, class: "px-1 text-sm text-slate-500 hover:text-slate-700" %>
<% end %>

<div class="mt-6 overflow-x-auto rounded-lg border border-slate-200 bg-white">
  <table class="w-full min-w-[720px] text-left text-sm" data-testid="admin-subscribers-table">
    <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="py-2 pl-4 pr-3 font-medium">Email</th>
        <th class="py-2 pr-3 font-medium">Status</th>
        <th class="py-2 pr-3 font-medium">Source</th>
        <th class="py-2 pr-3 font-medium">Subscribed</th>
        <th class="py-2 pr-4 font-medium">Left</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @subscribers.each do |subscriber| %>
        <tr data-testid="admin-subscriber-row">
          <td class="py-2 pl-4 pr-3">
            <%= link_to subscriber.email_address, admin_subscriber_path(subscriber), class: "font-medium text-slate-900 hover:text-amber-700" %>
          </td>
          <td class="py-2 pr-3">
            <span class="font-medium <%= subscriber_status_class(subscriber) %>"><%= subscriber.status %></span>
          </td>
          <td class="py-2 pr-3 text-slate-500"><%= subscriber.source.presence || "—" %></td>
          <td class="py-2 pr-3 whitespace-nowrap text-slate-500"><%= subscriber.subscribed_at.strftime("%b %-d, %Y %-I:%M %p") %></td>
          <td class="py-2 pr-4 whitespace-nowrap text-slate-500"><%= subscriber.unsubscribed_at&.strftime("%b %-d, %Y") || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @subscribers.empty? %>
    <p class="p-4 text-sm text-slate-500" data-testid="admin-subscribers-empty">No subscribers match this filter.</p>
  <% end %>
</div>

<% if @total > Admin::SubscribersController::PAGE_SIZE %>
  <nav class="mt-4 flex items-center justify-between text-sm text-slate-600" data-testid="admin-subscribers-pagination">
    <p><%= @total %> addresses</p>
    <div class="flex gap-3">
      <% if @page > 1 %>
        <%= link_to "Previous", admin_subscribers_path(status: @status, q: @query.presence, page: @page - 1), class: "font-medium text-amber-700 hover:text-amber-800" %>
      <% end %>
      <% if @page * Admin::SubscribersController::PAGE_SIZE < @total %>
        <%= link_to "Next", admin_subscribers_path(status: @status, q: @query.presence, page: @page + 1), class: "font-medium text-amber-700 hover:text-amber-800" %>
      <% end %>
    </div>
  </nav>
<% end %>
