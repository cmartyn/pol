<% content_for :title, "#{@pollster.name} · Admin · 535" %>

<%= link_to "← Pollsters", admin_pollsters_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
<h1 class="mt-3 font-serif text-2xl font-semibold text-slate-900"><%= @pollster.name %></h1>
<p class="mt-1 text-sm text-slate-600">
  <%= link_to "View polls", admin_polls_path(pollster_id: @pollster.id), class: "underline" %>
  &middot; <%= link_to "Public record", pollster_path(@pollster), class: "underline" %>
</p>

<%= form_with model: @pollster, url: admin_pollster_path(@pollster), class: "mt-6 max-w-xl space-y-5 rounded-lg border border-slate-200 bg-white p-5" do |form| %>
  <% if @pollster.errors.any? %>
    <p class="text-sm text-red-700" role="alert"><%= @pollster.errors.full_messages.to_sentence %></p>
  <% end %>
  <div>
    <%= form.label :excluded, class: "flex items-center gap-2 font-medium" do %>
      <%= form.check_box :excluded, class: "rounded border-slate-300" %>
      Exclude this pollster
    <% end %>
    <p class="mt-2 text-sm text-slate-600">All existing and future polls from this firm stay out of forecasts, charts, and new newsroom coverage. Stored polls remain available. Uncheck to reinstate.</p>
    <% if @pollster.excluded? %>
      <p class="mt-2 text-sm text-red-700">Excluded since <%= @pollster.excluded_at.in_time_zone.strftime("%B %-d, %Y") %>.</p>
    <% end %>
  </div>
  <div>
    <%= form.label :exclusion_reason, "Reason", class: "block text-sm font-medium" %>
    <%= form.text_area :exclusion_reason, rows: 3, maxlength: 1000, class: "mt-1 block w-full rounded-md border border-slate-300 p-2 text-sm", aria: { describedby: "reason-help" } %>
    <p id="reason-help" class="mt-1 text-xs text-slate-500">A short public explanation is required when excluding a pollster.</p>
  </div>
  <div>
    <%= form.label :exclusion_source_url, "Source link (optional)", class: "block text-sm font-medium" %>
    <%= form.url_field :exclusion_source_url, maxlength: 2000, class: "mt-1 block w-full rounded-md border border-slate-300 p-2 text-sm" %>
  </div>
  <%= form.submit "Save pollster", class: "cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
<% end %>

<section class="mt-8 max-w-2xl">
  <h2 class="font-serif text-xl font-semibold">Published dispatches citing this pollster</h2>
  <p class="mt-1 text-sm text-slate-600">Review these for corrections or retraction when excluding a firm.</p>
  <% if @dispatches.any? %>
    <ul class="mt-3 space-y-2" data-testid="pollster-citing-dispatches">
      <% @dispatches.each do |dispatch| %>
        <li><%= link_to dispatch.headline, admin_dispatch_path(dispatch), class: "text-sm underline underline-offset-2" %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-slate-500">No published dispatches cite this pollster.</p>
  <% end %>
</section>
