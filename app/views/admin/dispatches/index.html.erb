<% content_for :title, "Dispatches · Admin · 535" %>

<h1 class="font-serif text-2xl font-semibold text-slate-900">Dispatches</h1>

<%= form_with url: admin_dispatches_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3 rounded-lg border border-slate-200 bg-white p-4", data: { testid: "admin-dispatch-filters" } do %>
  <div>
    <label class="block text-xs font-medium text-slate-500" for="kind">Kind</label>
    <select name="kind" id="kind" class="mt-1 rounded-md border-slate-300 text-sm">
      <%= options_for_select([ [ "All kinds", "" ] ] + Dispatch.kinds.keys.map { |k| [ k.humanize, k ] }, params[:kind]) %>
    </select>
  </div>
  <div>
    <label class="block text-xs font-medium text-slate-500" for="status">Status</label>
    <select name="status" id="status" class="mt-1 rounded-md border-slate-300 text-sm">
      <%= options_for_select([ [ "All statuses", "" ] ] + Dispatch.statuses.keys.map { |s| [ s.capitalize, s ] }, params[:status]) %>
    </select>
  </div>
  <div>
    <label class="block text-xs font-medium text-slate-500" for="race_id">Race</label>
    <select name="race_id" id="race_id" class="mt-1 rounded-md border-slate-300 text-sm">
      <%= options_for_select([ [ "All races (incl. national)", "" ] ], params[:race_id].presence) %>
      <%= options_from_collection_for_select(@races, :id, :name, params[:race_id]) %>
    </select>
  </div>
  <button type="submit" class="rounded-md bg-slate-100 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200">Filter</button>
  <%= link_to "Reset", admin_dispatches_path, class: "px-1 text-sm text-slate-500 hover:text-slate-700" %>
<% end %>

<div class="mt-6 overflow-x-auto rounded-lg border border-slate-200 bg-white">
  <table class="w-full min-w-[860px] text-left text-sm" data-testid="admin-dispatches-table">
    <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="py-2 pl-4 pr-3 font-medium">Kind</th>
        <th class="py-2 pr-3 font-medium">Headline</th>
        <th class="py-2 pr-3 font-medium">Race</th>
        <th class="py-2 pr-3 font-medium">Model</th>
        <th class="py-2 pr-3 font-medium">Published</th>
        <th class="py-2 pr-4 font-medium">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @dispatches.each do |dispatch| %>
        <tr data-testid="admin-dispatch-row">
          <td class="py-2 pl-4 pr-3">
            <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= dispatch_kind_color(dispatch.kind) %>"><%= dispatch.kind.humanize %></span>
          </td>
          <td class="py-2 pr-3">
            <%= link_to dispatch.headline, admin_dispatch_path(dispatch), class: "font-medium text-slate-900 hover:text-amber-700" %>
            <% if dispatch.edited_at.present? %><span class="ml-1 rounded bg-blue-50 px-1.5 py-0.5 text-[10px] font-medium uppercase text-blue-700" data-testid="admin-dispatch-edited-marker">edited</span><% end %>
            <% if dispatch.retracted? %><span class="ml-1 rounded bg-red-50 px-1.5 py-0.5 text-[10px] font-medium uppercase text-red-700" data-testid="admin-dispatch-retracted-marker">retracted</span><% end %>
          </td>
          <td class="py-2 pr-3 text-slate-600">
            <% if dispatch.race %>
              <%= link_to dispatch.race.name, race_path(dispatch.race.slug), class: "hover:text-amber-700" %>
            <% else %>
              National
            <% end %>
          </td>
          <td class="py-2 pr-3 text-slate-500"><%= dispatch.model_slug %></td>
          <td class="py-2 pr-3 whitespace-nowrap text-slate-500"><%= dispatch.published_at&.strftime("%b %-d, %Y") || "—" %></td>
          <td class="py-2 pr-4">
            <span class="font-medium <%= dispatch.retracted? ? "text-red-700" : "text-green-700" %>"><%= dispatch.status %></span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @dispatches.empty? %>
    <p class="p-4 text-sm text-slate-500" data-testid="admin-dispatches-empty">No dispatches match this filter.</p>
  <% end %>
</div>
