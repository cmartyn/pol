<% content_for :title, "#{@poll.pollster.name} · Poll · Admin · 535" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Poll #<%= @poll.id %></p>
    <h1 class="font-serif text-2xl font-semibold text-slate-900"><%= @poll.pollster.name %></h1>
  </div>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_admin_poll_path(@poll), class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
    <%= button_to "Delete", admin_poll_path(@poll), method: :delete,
          form: { data: { turbo_confirm: "Delete this poll and its results? This can't be undone." } },
          class: "rounded-md border border-red-200 bg-white px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50" %>
  </div>
</div>

<dl class="mt-6 grid grid-cols-1 gap-x-8 gap-y-3 rounded-lg border border-slate-200 bg-white p-5 text-sm sm:grid-cols-2" data-testid="admin-poll-detail">
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Race</dt>
    <dd class="mt-0.5">
      <% if @poll.race %>
        <%= link_to @poll.race.name, race_path(@poll.race.slug), class: "font-medium text-amber-700 hover:text-amber-800" %>
      <% else %>
        Generic ballot
      <% end %>
    </dd>
  </div>
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Entry mode</dt>
    <dd class="mt-0.5"><span class="rounded-full px-2 py-0.5 text-xs font-medium <%= admin_entry_mode_badge_color(@poll.entry_mode) %>"><%= @poll.entry_mode %></span></dd>
  </div>
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Field dates</dt>
    <dd class="mt-0.5"><%= @poll.field_start&.strftime("%B %-d, %Y") %><%= " – " if @poll.field_start %><%= @poll.field_end.strftime("%B %-d, %Y") %></dd>
  </div>
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Sample</dt>
    <dd class="mt-0.5"><%= @poll.sample_size || "—" %> <span class="uppercase text-slate-500"><%= @poll.population %></span></dd>
  </div>
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Sponsor</dt>
    <dd class="mt-0.5"><%= @poll.sponsor.presence || "—" %></dd>
  </div>
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Source</dt>
    <dd class="mt-0.5"><%= safe_external_link(@poll.source_url, @poll.source_url, class: "break-all text-amber-700 hover:text-amber-800", target: "_blank", rel: "noopener nofollow", data: { testid: "admin-poll-source-link" }) %></dd>
  </div>
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Created</dt>
    <dd class="mt-0.5"><%= @poll.created_at.strftime("%B %-d, %Y %-I:%M %p") %></dd>
  </div>
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Dedup digest</dt>
    <dd class="mt-0.5 break-all font-mono text-xs text-slate-500" data-testid="admin-poll-digest"><%= @poll.dedup_digest %></dd>
  </div>
</dl>

<section class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
  <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Results</h2>
  <table class="mt-3 w-full max-w-lg text-left text-sm" data-testid="admin-poll-results-table">
    <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
      <tr><th class="py-1 pr-3 font-medium">Party</th><th class="py-1 pr-3 font-medium">Candidate</th><th class="py-1 font-medium">Pct</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @poll.poll_results.each do |result| %>
        <tr>
          <td class="py-1.5 pr-3 font-medium <%= party_text_color(result.party) %>"><%= result.party.capitalize %></td>
          <td class="py-1.5 pr-3 text-slate-700"><%= result.candidate&.name || "—" %></td>
          <td class="py-1.5 font-semibold"><%= number_with_precision(result.pct, precision: 1) %>%</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
  <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Raw payload</h2>
  <% if @poll.raw_payload.present? %>
    <pre class="mt-3 overflow-x-auto rounded-md bg-slate-50 p-3 text-xs text-slate-700" data-testid="admin-poll-raw-payload"><%= JSON.pretty_generate(@poll.raw_payload) %></pre>
  <% else %>
    <p class="mt-3 text-sm text-slate-500" data-testid="admin-poll-raw-payload-empty">No raw payload recorded.</p>
  <% end %>
</section>
