<% content_for :title, "Model run ##{@model_run.id} · Admin · 535" %>

<p class="text-xs font-medium uppercase tracking-wide text-slate-400">Model run #<%= @model_run.id %></p>
<h1 class="font-serif text-2xl font-semibold text-slate-900"><%= @model_run.started_at&.strftime("%B %-d, %Y %-I:%M %p") %></h1>

<dl class="mt-4 grid grid-cols-2 gap-x-8 gap-y-2 rounded-lg border border-slate-200 bg-white p-5 text-sm sm:grid-cols-4" data-testid="admin-model-run-detail">
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Status</dt>
    <dd class="mt-0.5 font-medium <%= @model_run.succeeded? ? "text-green-700" : (@model_run.failed? ? "text-red-700" : "text-amber-700") %>"><%= @model_run.status %></dd></div>
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Trigger</dt><dd class="mt-0.5"><%= @model_run.trigger %></dd></div>
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Finished</dt><dd class="mt-0.5"><%= @model_run.finished_at&.strftime("%-I:%M:%S %p") || "—" %></dd></div>
  <div><dt class="text-xs uppercase tracking-wide text-slate-400">Seed</dt><dd class="mt-0.5 font-mono text-xs"><%= @model_run.rng_seed %></dd></div>
</dl>

<% if @model_run.error_message.present? %>
  <p class="mt-4 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700" data-testid="admin-model-run-error"><%= @model_run.error_message %></p>
<% end %>

<section class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
  <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">
    Changes since <%= @previous_run ? "run ##{@previous_run.id} (#{@previous_run.started_at&.strftime('%b %-d, %Y')})" : "—" %>
  </h2>

  <% if @previous_run.nil? %>
    <p class="mt-2 text-sm text-slate-500" data-testid="admin-params-diff-empty">No earlier succeeded run to compare against.</p>
  <% elsif @diff[:added].empty? && @diff[:removed].empty? && @diff[:changed].empty? %>
    <p class="mt-2 text-sm text-slate-500" data-testid="admin-params-diff-empty">No parameter changes since the previous succeeded run.</p>
  <% else %>
    <table class="mt-3 w-full max-w-2xl text-left text-sm" data-testid="admin-params-diff-table">
      <thead class="text-xs uppercase tracking-wide text-slate-500"><tr><th class="py-1 pr-3 font-medium">Key</th><th class="py-1 pr-3 font-medium">Before</th><th class="py-1 font-medium">After</th></tr></thead>
      <tbody class="divide-y divide-slate-100">
        <% @diff[:changed].each do |change| %>
          <tr data-testid="admin-params-diff-row"><td class="py-1.5 pr-3 font-mono text-xs"><%= change.key %></td><td class="py-1.5 pr-3 text-slate-500"><%= change.before.inspect %></td><td class="py-1.5 font-medium text-slate-900"><%= change.after.inspect %></td></tr>
        <% end %>
        <% @diff[:added].each do |change| %>
          <tr data-testid="admin-params-diff-row"><td class="py-1.5 pr-3 font-mono text-xs">+ <%= change.key %></td><td class="py-1.5 pr-3 text-slate-400">—</td><td class="py-1.5 font-medium text-green-700"><%= change.after.inspect %></td></tr>
        <% end %>
        <% @diff[:removed].each do |change| %>
          <tr data-testid="admin-params-diff-row"><td class="py-1.5 pr-3 font-mono text-xs">&minus; <%= change.key %></td><td class="py-1.5 pr-3 text-red-700"><%= change.before.inspect %></td><td class="py-1.5 text-slate-400">—</td></tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<section class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
  <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Params snapshot</h2>
  <% if @model_run.params_snapshot.present? %>
    <pre class="mt-3 overflow-x-auto rounded-md bg-slate-50 p-3 text-xs text-slate-700" data-testid="admin-model-run-snapshot"><%= JSON.pretty_generate(@model_run.params_snapshot) %></pre>
  <% else %>
    <p class="mt-3 text-sm text-slate-500" data-testid="admin-model-run-snapshot-empty">No params snapshot recorded.</p>
  <% end %>
</section>
