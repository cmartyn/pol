<% content_for :title, "Unsubscribe · 535" %>

<div class="max-w-xl">
  <h1 class="font-serif text-3xl font-semibold text-slate-900">Unsubscribe from dispatches</h1>
  <p class="mt-3 text-slate-600">Stop sending new 535 dispatches to <strong class="text-slate-900"><%= @subscriber.email_address %></strong>?</p>

  <%= button_to "Unsubscribe", unsubscribe_path(token: params[:token]),
        params: { browser_confirmation: "1" },
        class: "mt-6 rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
</div>
