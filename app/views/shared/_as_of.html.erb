<%# locals: time — a ModelRun#started_at, or nil %>
<% if time %>
  <p class="font-figure text-[10px] tracking-tight text-slate-500" data-testid="as-of"><%= Site::Format.as_of(time) %></p>
<% else %>
  <p class="text-xs text-slate-500" data-testid="as-of">No completed forecast run yet</p>
<% end %>
