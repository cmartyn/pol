<%# The id is what the turbo_stream response targets. Both the footer copy
    and an in-page copy render on the dashboard and on dispatch pages, so the
    id has to name which one was submitted — see SubscriptionsController.

    layout: "card" (the default) is the boxed block on dispatch pages;
    "inline" is the dashboard's unboxed row beside the headline, kept to a
    label and a field so it fits above the fold on every phone and laptop —
    it leaves the unsubscribe and privacy line to the footer copy on the same
    page; "compact" is the footer's unboxed, smaller copy. It round-trips as
    a hidden field so the reply re-renders the submitted copy in the shape it
    left in.

    No pitch under the heading. What a subscriber gets is what the site
    already lists, and "every dispatch by email" says it. %>
<% layout = local_assigns.fetch(:layout, "card") %>
<% inline = layout == "inline" %>
<% notice = local_assigns[:notice] %>
<% alert = local_assigns[:alert] %>
<% heading_class = { "card" => "font-serif text-xl", "compact" => "font-serif text-lg", "inline" => "text-sm" }.fetch(layout, "font-serif text-xl") %>
<section id="subscription-form-<%= source %>" data-layout="<%= layout %>" data-testid="subscription-form"
         class="<%= "rounded-lg border border-amber-200 bg-amber-50 p-5" if layout == "card" %>">
  <h2 class="<%= heading_class %> font-semibold text-slate-900">Get every dispatch by email</h2>
  <% if notice || alert %>
    <p role="<%= notice ? "status" : "alert" %>" data-testid="subscription-result"
       class="mt-1 <%= layout == "card" ? "text-sm" : "text-xs" %> <%= notice ? "text-emerald-800" : "text-red-800" %>">
      <%= notice || alert %>
    </p>
  <% else %>
    <%# Inline keeps field and button on one row even on a phone — 375px
        has room for both, and stacking them would double its height above
        the forecast. %>
    <%= form_with url: subscription_path, scope: :subscriber, class: "#{inline ? "mt-2 flex-row" : "mt-3 flex-col sm:flex-row"} flex gap-2" do |form| %>
      <%= hidden_field_tag :source, source %>
      <%= hidden_field_tag :layout, layout %>
      <div class="hidden" aria-hidden="true">
        <%= label_tag :website, "Website" %>
        <%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %>
      </div>
      <%= form.label :email_address, "Email address", class: "sr-only" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email", placeholder: "you@example.com",
            class: "min-w-0 flex-1 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-200" %>
      <%= form.submit "Subscribe", class: "rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
    <% end %>
  <% end %>

  <% unless inline %>
    <p class="mt-2 text-xs text-slate-500">
      Easy out anytime:
      <%= link_to "manage or unsubscribe", email_preferences_path, class: "font-medium text-amber-700 hover:text-amber-800" %>.
      See the <%= link_to "privacy note", privacy_path, class: "font-medium text-amber-700 hover:text-amber-800" %>.
    </p>
  <% end %>
</section>
