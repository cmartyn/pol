<%# The id is what the turbo_stream response targets. A page can carry this
    form and the footer at once, so the id names which copy was submitted.
    See SubscriptionsController.

    layout round-trips as a hidden field so the reply redraws the submitted
    copy in the shape it left in:
      "card"  — the boxed close of a race or a dispatch
      "band"  — the unboxed ask under the chamber figures
      "inline"— a single row, kept for replies from a form rendered that way
      "compact" — the footer
      "dialog"  — the header modal; the dialog is already the box

    One promise on every copy. The dialog opens over any page and cannot
    know which one, and a race reader could misread a vaguer line as "this
    race only." The mail is still a published dispatch. %>
<% layout = local_assigns.fetch(:layout, "card") %>
<% inline = layout == "inline" %>
<% on_card = layout == "card" %>
<% notice = local_assigns[:notice] %>
<% alert = local_assigns[:alert] %>
<% heading_class = { "card" => "font-serif text-xl", "band" => "font-serif text-xl", "compact" => "font-serif text-lg", "inline" => "text-sm", "dialog" => "font-serif text-xl pr-8" }.fetch(layout, "font-serif text-xl") %>
<% support_class = on_card ? "text-amber-950" : "text-slate-600" %>
<section id="subscription-form-<%= source %>" data-layout="<%= layout %>" data-testid="subscription-form"
         class="<%= "max-w-xl" if layout == "band" %> <%= "rounded-lg border border-amber-200 bg-amber-50 p-5" if on_card %>">
  <h2 id="subscription-form-<%= source %>-heading" class="<%= heading_class %> font-semibold text-slate-900">The forecast, in your inbox</h2>
  <p class="mt-1 text-sm <%= support_class %>" data-testid="subscription-promise">A dispatch when the numbers move.</p>
  <% if notice || alert %>
    <p role="<%= notice ? "status" : "alert" %>" data-testid="subscription-result"
       class="mt-1 text-sm <%= notice ? "text-emerald-800" : "text-red-800" %>">
      <%= notice || alert %>
    </p>
  <% else %>
    <%# Inline keeps field and button on one row even on a phone — 375px
        has room for both, and stacking them would double its height above
        the forecast. %>
    <%= form_with url: subscription_path, scope: :subscriber, class: "#{inline ? "mt-2 flex-row" : "mt-3 flex-col sm:flex-row"} flex gap-2" do |form| %>
      <%= hidden_field_tag :source, source %>
      <%= hidden_field_tag :layout, layout %>
      <div class="hidden" aria-hidden="true">
        <%= label_tag :website, "Website" %>
        <%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %>
      </div>
      <%= form.label :email_address, "Email address", class: "sr-only" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email", placeholder: "you@example.com",
            class: "min-h-11 min-w-0 flex-1 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm placeholder:text-slate-600 focus:border-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-200" %>
      <%= form.submit "Subscribe", class: "min-h-11 rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
    <% end %>
  <% end %>

  <% unless inline %>
    <p class="mt-2 text-sm <%= support_class %>">
      Easy out anytime:
      <%= link_to "manage or unsubscribe", email_preferences_path, class: "font-medium text-amber-700 hover:text-amber-800" %>.
      See the <%= link_to "privacy note", privacy_path, class: "font-medium text-amber-700 hover:text-amber-800" %>.
    </p>
  <% end %>
</section>
