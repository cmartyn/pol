<% content_for :title, "Email preferences · 535" %>

<div class="max-w-xl">
  <h1 class="font-serif text-3xl font-semibold text-slate-900">Email preferences</h1>
  <p class="mt-3 text-slate-600">
    Every dispatch email has a one-click unsubscribe link. If you do not have one handy, enter your address and we will send you a secure link.
  </p>

  <%= form_with url: email_preferences_path, scope: :subscriber, class: "mt-6 space-y-3" do |form| %>
    <div class="hidden" aria-hidden="true">
      <%= label_tag :website, "Website" %>
      <%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %>
    </div>
    <div>
      <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-slate-700" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email",
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-200" %>
    </div>
    <%= form.submit "Send secure unsubscribe link", class: "rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
  <% end %>
</div>
