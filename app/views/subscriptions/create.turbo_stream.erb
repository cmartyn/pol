<%# Answering in place rather than redirecting: the page this was submitted
    from is edge-cached, so a redirect_back would land on a copy Cloudflare
    already holds and the flash would never render. %>
<%= turbo_stream.replace "subscription-form-#{@source}" do %>
  <%= render "shared/subscription_form",
        source: @source, compact: @compact, notice: @notice, alert: @alert %>
<% end %>
<% if @posthog_distinct_id.present? %>
  <%= turbo_stream.append "subscription-form-#{@source}" do %>
    <%= render "shared/posthog_identify", distinct_id: @posthog_distinct_id %>
  <% end %>
<% end %>
