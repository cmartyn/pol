<div class="mt-3 overflow-x-auto">
  <table class="stack-table w-full text-left text-sm lg:min-w-[900px]" data-testid="poll-feed-table">
    <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="py-2 pr-3 font-medium">Pollster</th>
        <th class="py-2 pr-3 font-medium">Race</th>
        <th class="py-2 pr-3 font-medium">Fielded</th>
        <th class="py-2 pr-3 font-medium">Sample</th>
        <th class="py-2 pr-3 font-medium">Results</th>
        <th class="py-2 pr-3 font-medium">Margin</th>
        <th class="py-2 font-medium">Source</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% feed.days.each do |day| %>
        <tr class="bg-slate-50">
          <th colspan="7" class="py-2 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500"
              data-testid="poll-feed-day" data-date="<%= day.date.iso8601 %>">
            <%= feed_day_heading(day.date) %>
            <span class="font-normal normal-case text-slate-600">&middot; <%= feed_poll_count(day.total) %></span>
          </th>
        </tr>
        <%= render partial: "polls/feed_row", collection: day.polls, as: :poll %>
      <% end %>
    </tbody>
  </table>
</div>
