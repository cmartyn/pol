<% content_for :title, "#{@race.name} · 535" %>

<%# "Race page core" from the brief's Performance section: everything below
    is keyed on the race itself (candidates, slug, name — Rails turns @race
    into an id+updated_at key on its own), the run its forecast/timeline
    come from, and this race's latest dispatch (@latest_dispatch, looked up
    cheaply in the controller — see RacesController#show — specifically so
    this key can be formed without loading the full dispatches list below).
    Every query this page needs (forecast, poll list, timeline payload,
    polls-scatter payload, the dispatches feed) is built inside the block so
    a cache hit skips all of them, not just the rendering. %>
<% cache [ "race-core", @race, @latest_run, @latest_dispatch ] do %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-serif text-3xl font-semibold text-slate-900" data-testid="race-name"><%= @race.name %></h1>
        <% if @race.special? %>
          <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Special election</span>
        <% end %>
        <% if @race.uncontested? %>
          <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Uncontested</span>
        <% end %>
      </div>

      <% party_order = %w[dem rep ind other] %>
      <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm">
        <% @race.candidates.sort_by { |candidate| party_order.index(candidate.party) || 99 }.each do |candidate| %>
          <li class="font-medium <%= party_text_color(candidate.party) %>">
            <%= candidate.name %> <span class="text-slate-400">(<%= candidate.party.capitalize %><%= " · incumbent" if candidate.incumbent? %>)</span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <%# Both internals views of the forecast render here; the header toggle
      picks one (VariantsHelper). The published row stands in when a
      pre-toggle run wrote only one variant. %>
  <% forecasts = forecasts_by_variant(->(variant) { @race.latest_forecast(variant: variant) }) %>
  <% forecast = forecasts[:excl_internals] %>

  <% if forecast %>
    <%= each_variant do |variant| %>
    <% variant_forecast = forecasts[variant] %>
    <p class="mt-4 max-w-2xl text-slate-700">
      <% rating = rating_word_for(@race, variant_forecast) %>
      <%# "Uncontested" is its own branch rather than falling through to the
          favoured-side sentence, because that sentence now states a literal
          simulation count and an uncontested race has none: Forecast::
          Simulator#certain_outcome awards the seat and draws no error at all.
          Printing "100,000 of 100,000 simulated elections" for it would be
          precisely the invented tally this phrasing was changed to stop. %>
      <% if rating == "Uncontested" %>
        This race is <strong class="font-semibold">Uncontested</strong> — only one candidate can win it, so
        the model awards the seat rather than simulating the race.
      <% elsif rating == "Tossup" %>
        This race is a <strong class="font-semibold">Tossup</strong> — the leading side wins
        <%= Site::Format.of_simulations(leading_probability(variant_forecast), n_sims: @latest_run.n_sims) %>.
      <% else %>
        <strong class="font-semibold <%= party_text_color(leading_party(variant_forecast)) %>">
          <%= { "dem" => "Democrats", "rep" => "Republicans", "other" => "The independent" }.fetch(leading_party(variant_forecast)) %>
        </strong>
        are favored, winning <%= Site::Format.of_simulations(leading_probability(variant_forecast), n_sims: @latest_run.n_sims) %>.
      <% end %>
    </p>
    <% end %>
  <% end %>

  <% if forecast %>
    <section class="mt-8 rounded-lg border border-slate-200 p-5" data-testid="forecast-detail">
      <h2 class="font-serif text-xl font-semibold text-slate-900">Forecast detail</h2>
      <%= render "shared/as_of", time: @latest_run&.started_at %>

      <%= each_variant do |variant| %>
      <% variant_forecast = forecasts[variant] %>
      <div class="mt-3 flex flex-wrap items-baseline gap-x-10 gap-y-3">
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Rating</p>
          <p class="text-lg font-semibold text-slate-900" data-testid="rating-word"><%= rating_word_for(@race, variant_forecast) %></p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Win probability</p>
          <p class="text-lg font-semibold"><%= probability_chip(variant_forecast) %></p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Estimated margin</p>
          <p class="text-lg font-semibold <%= party_text_color(margin_party(@race, variant_forecast.mean_margin)) %>">
            <%= formatted_margin(@race, variant_forecast.mean_margin) %>
          </p>
        </div>
        <% if variant_forecast.margin_percentiles.present? %>
          <% interval = Site::Format.percentile_interval(variant_forecast.margin_percentiles, side_a_party: race_sides(@race).first, side_b_party: race_sides(@race).second) %>
          <div data-testid="percentile-interval">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= interval[:label] %> interval</p>
            <p class="text-lg font-semibold text-slate-900"><%= interval[:low] %> to <%= interval[:high] %></p>
          </div>
        <% end %>
      </div>
      <% end %>
    </section>
  <% else %>
    <p class="mt-8 rounded-lg border border-slate-200 bg-slate-50 p-6 text-slate-600" data-testid="forecast-empty">
      No forecast run has covered this race yet.
    </p>
  <% end %>

  <section class="mt-10">
    <h2 class="font-serif text-xl font-semibold text-slate-900">Win probability over time</h2>
    <% timeline = Site::Charts::Timeline.build(race: @race) %>
    <div class="mt-3">
      <%= render "races/timeline_chart", payload: timeline %>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="font-serif text-xl font-semibold text-slate-900">Polls</h2>
    <% polls = @race.polls.model_corpus.recent_first.includes(:pollster, poll_results: :candidate) %>
    <%# The same adjustments the run on show actually applied, so the poll
        table's arithmetic and the reference line on the chart both match
        what the model did rather than each recomputing their own version. %>
    <% house_effects = HouseEffect.applied_lookup(@latest_run) %>
    <% polls_scatter = Site::Charts::PollsScatter.build(race: @race, polls: polls, as_of: Time.current,
                                                        house_effects: house_effects,
                                                        internals_shift: @latest_run&.internals_shift) %>
    <% if polls_scatter %>
      <%# Polling exists but measures contests that cannot all happen — a
          district whose nominees are unsettled gets a table per plausible
          one. Averaging them would publish a margin between people who are
          not running against each other, so the forecast stays on
          fundamentals and the polls stay on the page, grouped by what they
          asked. %>
      <% if polls_scatter[:average_reason] == :ambiguous_matchup %>
        <p class="mt-3 max-w-3xl rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900"
           data-testid="ambiguous-matchup-note">
          The recent polling here measures
          <%= pluralize(polls_scatter[:matchups].size, "different matchup") %>, so there is no single
          contest to average — the forecast rests on fundamentals
          (<%= @race.house? ? "the district's 2024 result" : "the state's partisan lean" %> and the
          national environment) until the nominees are settled. Every poll is below, grouped by the
          matchup it tested.
        </p>
      <% end %>
      <div class="mt-3">
        <%= render "races/polls_scatter_chart", payload: polls_scatter, race: @race %>
      </div>
      <div class="mt-6">
        <%= render "races/poll_table", race: @race, polls: polls, house_effects: house_effects %>
      </div>
    <% else %>
      <p class="mt-3 text-slate-600" data-testid="unpolled-empty-state">
        No public polling — forecast rests on fundamentals (state lean, national environment).
      </p>
    <% end %>
  </section>

  <section class="mt-10 border-t border-slate-200 pt-6">
    <h2 class="font-serif text-xl font-semibold text-slate-900">Dispatches about this race</h2>
    <div class="mt-3 max-w-3xl">
      <% dispatches = @race.dispatches.published.recent_first.includes(:model_run) %>
      <% if dispatches.any? %>
        <%= render partial: "dispatches/dispatch", collection: dispatches, as: :dispatch %>
      <% else %>
        <p class="text-slate-500" data-testid="dispatches-empty">No dispatches about this race yet.</p>
      <% end %>
    </div>
  </section>
<% end %>
