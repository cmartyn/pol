<% content_for :title, "#{@race.name} · 535" %>

<%# Outside the fragment cache on purpose: this only tells the browser which
    event to send. The page is edge-cached, so a server-side capture would
    miss every Cloudflare hit. %>
<div hidden data-controller="analytics-event" data-analytics-event-name-value="race_viewed" data-analytics-event-properties-value="<%= { race_slug: @race.slug, race_state: @race.state, race_office: @race.office }.to_json %>"></div>

<% back_path, back_name = if @race.house?
     [ house_path, "House" ]
   elsif @race.senate?
     [ senate_path, "Senate" ]
   else
     [ root_path, "Dashboard" ]
   end %>
<%= link_to "Back to #{back_name}", back_path,
      class: "mb-3 inline-flex min-h-11 items-center text-sm font-medium text-slate-700 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 xl:hidden",
      data: { testid: "race-back" } %>

<%# "Race page core" from the brief's Performance section: everything below
    is keyed on the race itself (candidates, slug, name — Rails turns @race
    into an id+updated_at key on its own), the run its forecast/timeline
    come from, and this race's latest dispatch (@latest_dispatch, looked up
    cheaply in the controller — see RacesController#show — specifically so
    this key can be formed without loading the full dispatches list below)
    and the boundaries the header map is drawn from.
    Every query this page needs (forecast, poll list, timeline payload,
    polls-scatter payload, the dispatches feed) is built inside the block so
    a cache hit skips all of them, not just the rendering. %>
<%= render "shared/forecast_exclusion_notice" %>

<% cache [ "race-core", @race, @latest_run, @latest_dispatch, Forecast::HouseBaselines.current.revision, Site::CacheKey.collection_freshness(Boundary.all) ] do %>
  <%# Both internals views of the forecast render here; the header toggle
      picks one (VariantsHelper). The published row stands in when a
      pre-toggle run wrote only one variant. %>
  <% forecasts = forecasts_by_variant(->(variant) { @race.latest_forecast(variant: variant) }) %>
  <% forecast = forecasts[:excl_internals] %>
  <%# Built first: the masthead's change line reads it as well as the chart. %>
  <% timeline = Site::Charts::Timeline.build(race: @race) %>
  <% latest_time = @latest_run&.started_at || Time.current %>

  <div class="flex flex-wrap items-start justify-between gap-x-10 gap-y-6 sm:items-center">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-serif text-3xl font-semibold text-slate-900" data-testid="race-name"><%= @race.name %></h1>
        <% if @race.special? %>
          <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Special election</span>
        <% end %>
        <% if @race.uncontested? %>
          <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">Uncontested</span>
        <% end %>
      </div>

      <% party_order = %w[dem rep ind other] %>
      <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm">
        <% @race.candidates.sort_by { |candidate| party_order.index(candidate.party) || 99 }.each do |candidate| %>
          <li class="font-medium <%= party_text_color(candidate.party) %>">
            <%= candidate.name %> <span class="text-slate-600">(<%= candidate.party.capitalize %><%= " · incumbent" if candidate.incumbent? %>)</span>
          </li>
        <% end %>
      </ul>

      <%# The masthead is the forecast: the rating labels it, the win
          probability is the figure, the change line says what just moved,
          and the simulation count is the caption. Margin and interval
          close it, so every number about the forecast is in one place.
          "Uncontested" has no figure — Forecast::Simulator#certain_outcome
          awards the seat and draws no error, so a percentage here would be
          the invented tally the caption was written to stop. %>
      <% if forecast %>
        <div class="mt-6 border-t border-slate-200 pt-5" data-testid="race-masthead">
          <% if rating_word_for(@race, forecast) == "Uncontested" %>
            <p class="eyebrow text-xs text-slate-700" data-testid="rating-word">Uncontested</p>
            <p class="mt-2 max-w-2xl text-slate-600">
              This race is <strong class="font-semibold">Uncontested</strong> — only one candidate can win it, so
              the model awards the seat rather than simulating the race.
            </p>
          <% else %>
            <%= each_variant do |variant| %>
              <% variant_forecast = forecasts[variant] %>
              <% rating = rating_word_for(@race, variant_forecast) %>
              <% party = leading_party(variant_forecast) %>
              <% probability = leading_probability(variant_forecast) %>
              <% party_name = { "dem" => "Democrats", "rep" => "Republicans", "other" => "The independent" }.fetch(party) %>
              <% change = timeline[:change][variant] %>
              <p class="eyebrow text-xs <%= rating == "Tossup" ? "text-slate-700" : party_text_color(party) %>" data-testid="rating-word"><%= rating %></p>
              <%# The chamber card's figure at the same proportions. Inline
                  spans, not flex: flex items would each read as their own
                  line rather than as "D 72%". %>
              <p class="mt-1 font-figure font-bold <%= party_text_color(party) %>" data-testid="win-probability">
                <span class="sr-only"><%= party_name %></span><span class="mr-1.5 text-lg tracking-[0.18em]" aria-hidden="true"><%= RacesHelper::PARTY_LETTER.fetch(party) %></span><span class="text-5xl tracking-tighter"><%= Site::Format.percent_value(probability) %></span><span class="ml-0.5 text-2xl opacity-45">%</span>
              </p>
              <%# What just moved, against the last run that was meaningfully
                  different (Site::ForecastChange). When a dispatch has been
                  written since, it is one tap away. %>
              <% if (line = forecast_change_line(change, latest_time: latest_time)) %>
                <p class="mt-2 max-w-2xl font-medium text-slate-900" data-testid="forecast-change">
                  <%= line %>
                  <% if change.kind != :steady && @latest_dispatch&.published_at && @latest_dispatch.published_at >= change.time %>
                    <%= link_to "Read the latest dispatch", dispatch_path(@latest_dispatch),
                          class: "whitespace-nowrap font-medium text-amber-700 underline decoration-amber-300 underline-offset-4 hover:text-amber-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600",
                          data: { testid: "forecast-change-dispatch" } %>
                  <% end %>
                </p>
              <% end %>
              <p class="mt-2 max-w-2xl text-slate-600">
                <% if rating == "Tossup" %>
                  This race is a <strong class="font-semibold">Tossup</strong> — the leading side wins
                  <%= Site::Format.of_simulations(probability, n_sims: @latest_run.n_sims) %>.
                <% else %>
                  <strong class="font-semibold <%= party_text_color(party) %>">
                    <%= party_name %>
                  </strong>
                  <%= party == "other" ? "is" : "are" %> favored, winning <%= Site::Format.of_simulations(probability, n_sims: @latest_run.n_sims) %>.
                <% end %>
              </p>
            <% end %>
          <% end %>

          <%# Says which forecast this is while partisan internals are on,
              beside the published figure it replaced. %>
          <% published = forecasts[:excl_internals] %>
          <%= render "shared/internals_marker",
                published: "#{RacesHelper::PARTY_LETTER.fetch(leading_party(published))} #{Site::Format.percent(leading_probability(published))}" %>

          <div class="mt-5 border-t border-slate-100 pt-4" data-testid="forecast-detail">
            <%= each_variant do |variant| %>
              <% variant_forecast = forecasts[variant] %>
              <dl class="flex flex-wrap items-baseline gap-x-10 gap-y-3">
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wide text-slate-600">Estimated margin</dt>
                  <dd class="text-lg font-semibold <%= party_text_color(margin_party(@race, variant_forecast.mean_margin)) %>">
                    <%= formatted_margin(@race, variant_forecast.mean_margin) %>
                  </dd>
                </div>
                <% if variant_forecast.margin_percentiles.present? %>
                  <% interval = Site::Format.percentile_interval(variant_forecast.margin_percentiles, side_a_party: race_sides(@race).first, side_b_party: race_sides(@race).second) %>
                  <div data-testid="percentile-interval">
                    <dt class="text-xs font-medium uppercase tracking-wide text-slate-600"><%= interval[:label] %> interval</dt>
                    <dd class="text-lg font-semibold text-slate-900"><%= interval[:low] %> to <%= interval[:high] %></dd>
                  </div>
                <% end %>
              </dl>
            <% end %>
            <div class="mt-2"><%= render "shared/as_of", time: @latest_run&.started_at %></div>
          </div>
        </div>
      <% else %>
        <p class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-6 text-slate-600" data-testid="forecast-empty">
          No forecast run has covered this race yet.
        </p>
      <% end %>

    </div>
    <%# A Senate race gets a locator; a House race gets its state's districts
        with its own outlined. Both return nil until boundaries are seeded. %>
    <% race_map = @race.house? ? Site::Maps::StateMap.build(@race) : Site::Maps::SenateMap.build(highlight: @race) %>
    <% if race_map %>
      <div class="w-full shrink-0 <%= @race.house? ? "sm:w-80 lg:w-96" : "map-locator sm:w-64 lg:w-80" %>" data-testid="race-map">
        <%= render "races/map", payload: race_map, show_legend: false %>
      </div>
    <% end %>
  </div>

  <%# What the forecast rests on before polling, in methodology's words —
      the unpolled and ambiguous-matchup notes below both name it. %>
  <% baseline = @race.forecast_baseline if @race.house? %>
  <% fundamentals = if !@race.house?
       "the state's partisan lean"
     elsif baseline&.presidential?
       "the 2024 presidential vote on the district's new lines"
     else
       "the district's 2024 result"
     end %>

  <%# Where a redrawn district's forecast starts. It names polls only when
      some are in the published average: an unpolled district's forecast
      is the baseline and the national environment alone. %>
  <% if forecast && baseline&.presidential? %>
    <p class="mt-6 max-w-prose text-sm text-slate-600" data-testid="forecast-baseline">
      This district was redrawn for 2026. Its starting point is the 2024 presidential vote
      recalculated on the new lines: <strong><%= house_margin(baseline.margin) %></strong>,
      <% if forecast.effective_poll_weight.positive? %>
        adjusted for the national environment, then blended with this district's polls.
      <% else %>
        adjusted for the national environment. No district poll is in the average.
      <% end %>
      <%= link_to "Source: The Downballot", baseline.source_url, class: "underline" %>.
      The <%= house_margin(@race.baseline_margin) %> House result in 2024 describes the old district.
    </p>
  <% end %>

  <section class="mt-10">
    <h2 class="font-serif text-xl font-semibold text-slate-900">
      Win probability over time
      <span class="ml-1 whitespace-nowrap rounded bg-slate-100 px-2 py-0.5 align-middle font-sans text-xs font-medium text-slate-700"
            data-variant="incl_internals" data-testid="chart-internals-tag">With partisan internals</span>
    </h2>
    <% if timeline[:baseline_corrections].any? %>
      <p class="mt-2 max-w-prose text-sm text-slate-600" data-testid="baseline-correction-note">
        Forecast inputs were corrected on <%= timeline[:baseline_corrections].join(", ") %> to account for redistricting.
        Changes across that correction are model changes, not a measure of voter movement.
      </p>
    <% end %>
    <% if timeline[:polling_corrections].any? %>
      <p class="mt-2 max-w-prose text-sm text-slate-600" data-testid="polling-correction-note">
        Polling inputs were corrected on <%= timeline[:polling_corrections].join(", ") %> to retain candidates
        sharing a party and use final ranked-choice rounds when available. Changes across this correction
        reflect the data repair and recalculated pollster adjustments, not voter movement.
      </p>
    <% end %>
    <div class="mt-3">
      <%= render "races/timeline_chart", payload: timeline %>
    </div>
  </section>

  <%# The ask follows what moved and the line it moved on, before the
      poll table. Neutral, not amber: amber on this page is a warning. %>
  <div class="mt-10 max-w-xl">
    <%= render "shared/subscription_form", source: "race", layout: "card" %>
  </div>

  <section class="mt-10">
    <h2 class="font-serif text-xl font-semibold text-slate-900">Polls</h2>
    <% polls = @race.polls.model_corpus.recent_first.includes(:pollster, poll_results: :candidate) %>
    <%# The same adjustments the run on show actually applied, so the poll
        table's arithmetic and the reference line on the chart both match
        what the model did rather than each recomputing their own version. %>
    <% house_effects = HouseEffect.applied_lookup(@latest_run) %>
    <% polls_scatter = Site::Charts::PollsScatter.build(race: @race, polls: polls, as_of: Time.current,
                                                        house_effects: house_effects,
                                                        internals_shift: @latest_run&.internals_shift) %>
    <% if polls_scatter %>
      <%# Polling exists but measures contests that cannot all happen — a
          district whose nominees are unsettled gets a table per plausible
          one. Averaging them would publish a margin between people who are
          not running against each other, so the forecast stays on
          fundamentals and the polls stay on the page, grouped by what they
          asked. %>
      <% if polls_scatter[:average_reason] == :ambiguous_matchup %>
        <p class="mt-3 max-w-3xl rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900"
           data-testid="ambiguous-matchup-note">
          The recent polling here measures
          <%= pluralize(polls_scatter[:matchups].size, "different matchup") %>, so there is no single
          contest to average — the forecast rests on fundamentals
          (<%= fundamentals %> and the national environment). Every poll is below, grouped by the
          matchup it tested.
        </p>
      <% end %>
      <div class="mt-3">
        <%= render "races/polls_scatter_chart", payload: polls_scatter, race: @race %>
      </div>
      <div class="mt-6">
        <%= render "races/poll_table", race: @race, polls: polls, house_effects: house_effects %>
      </div>
    <% else %>
      <p class="mt-3 max-w-prose text-slate-600" data-testid="unpolled-empty-state">
        No public polling — forecast rests on fundamentals (<%= fundamentals %> and the national environment).
      </p>
    <% end %>
  </section>

  <section class="mt-10 border-t border-slate-200 pt-6">
    <h2 class="font-serif text-xl font-semibold text-slate-900">Dispatches about this race</h2>
    <div class="mt-3 max-w-3xl">
      <% dispatches = @race.dispatches.published.recent_first.includes(:model_run).to_a %>
      <%# The newest three as teasers; the rest by date and headline. A race
          the newsroom has followed all autumn otherwise ran to two dozen
          teasers under the poll table. Each one keeps its permalink, and
          the race link each card carries elsewhere would point here. %>
      <% teasers, earlier = dispatches.first(3), dispatches.drop(3) %>
      <% if dispatches.any? %>
        <%# Its own wrapper, so the last teaser drops its rule (last:) and
            the earlier list's rule is the only one between them. %>
        <div>
          <%= render partial: "dispatches/dispatch", collection: teasers, as: :dispatch, locals: { show_race: false } %>
        </div>
      <% else %>
        <p class="text-slate-500" data-testid="dispatches-empty">No dispatches about this race yet.</p>
      <% end %>

      <% if earlier.any? %>
        <div class="mt-2 border-t border-slate-200 pt-5" data-testid="earlier-dispatches">
          <h3 class="text-xs font-medium uppercase tracking-wide text-slate-500">
            Earlier dispatches <span class="font-normal normal-case text-slate-600">&middot; <%= earlier.size %></span>
          </h3>
          <ol class="mt-1 divide-y divide-slate-100">
            <% earlier.each do |dispatch| %>
              <li class="flex flex-col gap-0.5 py-3 sm:flex-row sm:items-baseline sm:gap-6" data-testid="earlier-dispatch">
                <% if dispatch.published_at %>
                  <time datetime="<%= dispatch.published_at.iso8601 %>" class="shrink-0 text-xs text-slate-600 sm:w-24">
                    <%= dispatch.published_at.strftime("%b %-d, %Y") %>
                  </time>
                <% end %>
                <%= link_to dispatch.headline, dispatch_path(dispatch),
                      class: "font-serif font-semibold leading-snug text-slate-900 decoration-amber-500 decoration-2 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600" %>
              </li>
            <% end %>
          </ol>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
