<%# locals: race, polls — preloaded with :poll_results and :pollster, recent_first;
    house_effects — { pollster_id => applied effect } for the run on show. %>
<%# A race whose polls measure more than one contest is shown grouped by
    contest rather than as one undifferentiated list: the rows are not
    comparable with each other, and a reader scanning the margin column
    should be able to see why. %>
<% groups = polls.group_by(&:matchup_key) %>
<div data-controller="matchup-filter">
<% if groups.size > 1 %>
  <div class="mb-4">
    <label for="poll-matchup" class="block text-sm font-medium text-slate-700">Candidate matchup</label>
    <select id="poll-matchup" class="mt-1 w-full max-w-full rounded border border-slate-300 p-2 text-sm sm:w-auto"
            aria-controls="race-poll-table" aria-describedby="poll-matchup-help"
            data-matchup-filter-target="select" data-action="change->matchup-filter#filter">
      <option value="">All matchups</option>
      <% groups.values.each_with_index do |group, index| %>
        <option value="<%= index %>"><%= group.first.matchup_heading %> · <%= pluralize(group.size, "poll") %></option>
      <% end %>
    </select>
    <p id="poll-matchup-help" class="mt-2 text-xs text-slate-600">
      Filters this polling table only. Forecast values and scatter-chart data remain unchanged.
      Choose All matchups to restore every group.
    </p>
    <p class="mt-1 text-xs text-slate-600" role="status" data-matchup-filter-target="status">
      Showing <%= pluralize(polls.size, "poll") %> across all matchups.
    </p>
  </div>
<% end %>
<% if polls.any?(&:internal?) %>
  <%# One line of provenance per view, swapped with the toggle: what this
      view's average did with the flagged rows below. %>
  <p class="mb-2 text-xs text-slate-500" data-testid="internals-note">
    <%= variant_swap(
          "Polls from partisan-aligned sponsors are shown but not in this view's average — flip “Partisan internals” in the header to include them.",
          safe_join([ "Partisan-sponsored polls are in this view's average, shifted #{number_with_precision(@latest_run&.internals_shift || Pol::Params.fetch!(:internals, :prior_shift), precision: 1)} points toward the non-sponsor party and given half weight — ".html_safe,
                      link_to("methodology", methodology_path(anchor: "internals")), "." ])
        ) %>
  </p>
<% end %>
<div class="overflow-x-auto">
  <table id="race-poll-table" class="stack-table w-full text-left text-sm lg:min-w-[760px]" data-testid="poll-table">
    <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="py-2 pr-3 font-medium">Pollster</th>
        <th class="py-2 pr-3 font-medium">Dates</th>
        <th class="py-2 pr-3 font-medium">Sample</th>
        <th class="py-2 pr-3 font-medium">Results</th>
        <th class="py-2 pr-3 font-medium">Margin</th>
        <th class="py-2 pr-3 font-medium">
          <%= link_to "House adj.", pollsters_path, class: "hover:text-amber-700",
                      title: "Pollster house effect removed before averaging" %>
        </th>
        <th class="py-2 font-medium">Source</th>
      </tr>
    </thead>
      <% if groups.size > 1 %>
        <% groups.each_with_index do |(key, group), index| %>
          <tbody class="divide-y divide-slate-100" data-matchup-filter-target="group"
                 data-group="<%= index %>" data-count="<%= group.size %>">
          <tr class="bg-slate-50" data-testid="poll-matchup-heading" data-matchup="<%= key %>">
            <th colspan="7" class="py-2 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
              <%= group.first.matchup_heading %>
              <span class="font-normal normal-case text-slate-600">&middot; <%= pluralize(group.size, "poll") %></span>
              <% if earlier_matchup?(race, key) %>
                <span class="ml-1 rounded bg-slate-100 px-2 py-0.5 text-xs font-medium normal-case text-slate-600"
                      data-testid="earlier-matchup-tag">Different candidate matchup</span>
              <% end %>
            </th>
          </tr>
          <%= render partial: "races/poll_row", collection: group, as: :poll,
                     locals: { race: race, house_effects: house_effects } %>
          </tbody>
        <% end %>
      <% else %>
        <tbody class="divide-y divide-slate-100">
        <%= render partial: "races/poll_row", collection: polls, as: :poll,
                   locals: { race: race, house_effects: house_effects } %>
        </tbody>
      <% end %>
  </table>
</div>
</div>
