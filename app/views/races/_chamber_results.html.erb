<% totals = RaceResult.summary(chamber) %>
<section class="rounded-lg border border-slate-200 bg-slate-50 p-5" aria-label="<%= chamber.capitalize %> results">
  <h2 class="font-serif text-xl font-semibold text-slate-900"><%= chamber.capitalize %> results</h2>
  <div class="mt-3 flex flex-wrap gap-x-8 gap-y-3">
    <% { "dem" => "Democratic", "rep" => "Republican", "ind" => "Independent", "other" => "Other" }.each do |party, name| %>
      <% count = totals[:parties].fetch(party, 0) %>
      <% if count.positive? || %w[dem rep].include?(party) %>
        <span class="<%= party_text_color(party) %>">
          <span class="block font-figure text-3xl font-bold tracking-tight"><%= count %></span>
          <span class="block text-sm font-medium"><%= name %></span>
        </span>
      <% end %>
    <% end %>
  </div>
  <p class="mt-3 text-xs text-slate-600">Winners recorded for seats on the ballot</p>
  <p class="mt-2 border-t border-slate-200 pt-2 text-sm text-slate-700">
    <%= link_to "#{totals[:outstanding]} outstanding", url_for(controller: "/races", action: chamber, status: "outstanding", only_path: true, anchor: "race-table"), class: "inline-flex min-h-11 items-center font-semibold text-amber-800 underline decoration-amber-300 underline-offset-4 hover:text-amber-950 focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-600" %>
    <span class="ml-1">of <%= totals[:total] %> races</span>
  </p>
</section>
