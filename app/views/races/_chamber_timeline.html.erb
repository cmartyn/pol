<%# locals: history — Site::ChamberHistory.new(chamber:, seats: true)
            payload — Site::Charts::ChamberTimeline.build(history)

    A chamber page's "Forecast over time": chance of control and expected
    seats in every run, drawn by chamber_timeline_chart_controller.js. The
    correction note, when there is one, sits above the chart it explains. %>
<section class="min-w-0 max-w-4xl" data-testid="chamber-timeline">
  <h2 class="font-serif text-xl font-semibold text-slate-900">Forecast over time</h2>

  <% if (note = chamber_correction_note(history.chamber, history.corrections)) %>
    <p class="mt-2 max-w-prose text-sm text-slate-600" data-testid="chamber-correction-note"><%= note %></p>
  <% end %>

  <% if payload[:sparse] %>
    <p class="mt-2 text-sm text-slate-500" data-testid="chamber-timeline-sparse-note">
      Only <%= pluralize(payload[:t].size, "model run") %> so far — the trend will fill in as more land.
    </p>
  <% end %>

  <%# tabindex puts the chart in the tab order for the controller's arrow-key
      stepping; role="group" makes its aria-label announceable. The viewBox
      only reserves layout space until the controller connects and draws at
      the real pixel width. %>
  <div class="mt-3 w-full rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-600"
       data-controller="chamber-timeline-chart" tabindex="0" role="group"
       aria-label="<%= history.chamber.capitalize %> forecast in every model run; use left and right arrow keys to step through runs">
    <svg data-chamber-timeline-chart-target="svg" viewBox="0 0 640 380" class="h-auto w-full"
         role="img" aria-label="Chance of control and expected seats over time"></svg>
    <p class="sr-only" aria-live="polite" data-chamber-timeline-chart-target="live"></p>
    <script type="application/json" data-chamber-timeline-chart-target="payload"><%= json_escape(payload.to_json).html_safe %></script>
  </div>

  <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-0.5 w-3 rounded-full bg-blue-700"></span> Dem</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-0.5 w-3 rounded-full bg-red-700"></span> Rep</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2 w-3 rounded-sm bg-blue-700/15"></span> <%= payload[:words][:range] %> of seats</span>
    <% if payload[:corrections].any? %>
      <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 border-l border-dashed border-slate-400"></span> Data correction</span>
    <% end %>
  </p>
</section>
