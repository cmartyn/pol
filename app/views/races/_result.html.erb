<section class="my-5 rounded-lg border border-slate-200 bg-slate-50 p-4" aria-label="Election result" data-testid="race-result">
  <h2 class="eyebrow text-xs text-slate-700"><%= result_label(result) %></h2>
  <% if result&.winner %>
    <p class="mt-1 font-serif text-2xl font-semibold <%= party_text_color(result.winner.fetch("party")) %>"><%= result.winner.fetch("name") %> <span class="font-sans text-sm">(<%= Site::Format::PARTY_LETTER.fetch(result.winner.fetch("party")) %>)</span></p>
  <% end %>
  <% if (call = result&.decision) %>
    <p class="mt-1 text-sm text-slate-600">
      <%= safe_external_link(call.fetch("url"), call.fetch("source"), class: "underline") %>
      <% if call["decided_at"] %> · <%= result_time(call.fetch("decided_at")) %>
      <% elsif result.called? %> · Call time unavailable<% end %>
    </p>
  <% end %>
  <% if result&.reported_at %>
    <details class="mt-3 border-t border-slate-200 pt-3" <%= "open" unless result.called? %>>
      <summary class="cursor-pointer text-sm font-medium text-slate-800"><%= number_with_delimiter(result.votes.sum { |row| row.fetch("votes") }) %> reported votes · <%= result_time(result.reported_at) %></summary>
      <dl class="mt-2 max-w-md space-y-1 text-sm">
        <% result.votes.sort_by { |row| -row.fetch("votes") }.each do |row| %>
          <div class="flex justify-between gap-4">
            <dt><%= row.fetch("name") %> <span class="text-slate-600">· <%= row.fetch("party_label") %></span></dt>
            <dd class="font-figure font-semibold text-slate-900"><%= number_with_delimiter(row.fetch("votes")) %></dd>
          </div>
        <% end %>
      </dl>
      <p class="mt-2 text-xs text-slate-600"><%= safe_external_link(result.returns_url, "civicAPI vote report", class: "underline") %></p>
    </details>
  <% end %>
</section>
