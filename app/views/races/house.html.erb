<% content_for :title, "House · Pol" %>

<h1 class="font-serif text-3xl font-semibold text-slate-900">House</h1>
<p class="mt-1 text-slate-600">All 435 districts.</p>
<%= render "shared/as_of", time: @latest_run&.started_at %>

<% if @histogram %>
  <div class="mt-6 max-w-xl rounded-lg border border-slate-200 p-5">
    <%= render "home/chamber_card", chamber_forecast: @house_chamber_forecast, histogram: @histogram,
                                     title: "House", house: true %>
  </div>
<% else %>
  <p class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-6 text-slate-600" data-testid="chamber-card-empty">
    No forecast run has completed yet.
  </p>
<% end %>

<div class="mt-10" data-controller="table-filter">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <label class="min-w-0 flex-1">
      <span class="sr-only">Search by state or district</span>
      <input type="text" data-table-filter-target="input" data-action="input->table-filter#filter"
             placeholder="Search by state or district (e.g. NY or NY-17)"
             class="w-full max-w-sm rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none"
             data-testid="house-search-input">
    </label>
    <p class="whitespace-nowrap text-sm text-slate-500">
      <span data-table-filter-target="count"><%= @rows.size %></span> of <%= @rows.size %> districts
    </p>
  </div>

  <div class="mt-4 overflow-x-auto">
    <table class="w-full min-w-[560px] text-left text-sm" data-testid="house-table">
      <thead class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="py-2 pr-3 font-medium">District</th>
          <th class="py-2 pr-3 font-medium">Rating</th>
          <th class="py-2 pr-3 font-medium">Win prob.</th>
          <th class="py-2 pr-3 font-medium">2024 baseline</th>
          <th class="py-2 font-medium">Polls</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @rows.each do |row| %>
          <tr data-table-filter-target="row" data-search="<%= house_search_text(row.race) %>" data-testid="house-race-row">
            <td class="py-2 pr-3">
              <%= link_to row.race.name, race_path(row.race.slug), class: "font-medium text-slate-900 hover:text-amber-700" %>
            </td>
            <td class="py-2 pr-3 text-slate-700" data-testid="rating-word"><%= rating_word_for(row.race, row.forecast) || "—" %></td>
            <td class="py-2 pr-3"><%= probability_chip(row.forecast) %></td>
            <td class="py-2 pr-3 whitespace-nowrap">
              <span class="font-medium <%= party_text_color(house_margin_party(row.race.baseline_margin)) %>">
                <%= house_margin(row.race.baseline_margin) || "—" %>
              </span>
              <% if row.race.baseline_imputed? %>
                <span class="ml-1 rounded bg-amber-50 px-1 py-0.5 text-[10px] font-medium uppercase text-amber-700"
                      data-testid="baseline-imputed-marker"
                      title="Estimated baseline: no major-party opponent in 2024 — see Methodology.">est.</span>
              <% end %>
            </td>
            <td class="py-2 text-slate-600"><%= row.poll_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p class="mt-4 hidden text-center text-sm text-slate-500" data-table-filter-target="noResults" data-testid="house-no-results">
      No districts match your search.
    </p>
  </div>
</div>
