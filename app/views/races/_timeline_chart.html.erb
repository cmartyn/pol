<%# locals: payload — Site::Charts::Timeline.build(race:) %>
<div data-testid="timeline-chart">
  <% if payload[:points].empty? %>
    <p class="text-sm text-slate-500" data-testid="timeline-empty">No model run has forecast this race yet.</p>
  <% else %>
    <% if payload[:sparse] %>
      <p class="mb-2 text-sm text-slate-500" data-testid="timeline-sparse-note">
        Only <%= pluralize(payload[:points].size, "model run") %> so far — the trend will fill in as more land.
      </p>
    <% end %>
    <%# tabindex puts the whole chart in the tab order for the controller's
        arrow-key scrubbing; role="group" makes the aria-label announceable.
        The viewBox only reserves layout space until the controller connects —
        it renders at real pixel size and removes it. %>
    <div data-controller="timeline-chart" class="w-full" tabindex="0" role="group"
         aria-label="Win probability over time; use left and right arrow keys to step through model runs">
      <svg data-timeline-chart-target="svg" viewBox="0 0 640 220" class="h-auto w-full"
           role="img" aria-label="Win probability over time"></svg>
      <script type="application/json" data-timeline-chart-target="payload"><%= json_escape(payload.to_json).html_safe %></script>
    </div>
    <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
      <span><span class="inline-block h-2 w-2 rounded-full bg-blue-700"></span> Dem win probability</span>
      <span><span class="inline-block h-2 w-2 rounded-full bg-red-700"></span> Rep win probability</span>
      <% if payload[:show_other] %>
        <span><span class="inline-block h-2 w-2 rounded-full bg-slate-500"></span> Other win probability</span>
      <% end %>
      <span><span class="inline-block h-2 w-3 bg-slate-100 align-middle"></span> Tossup band</span>
    </p>
  <% end %>
</div>
