<%# locals: model_run (a succeeded ModelRun — callers only render this partial
    once one exists), chamber ("senate"/"house"), title, house (boolean).
    Self-contained rather than taking a precomputed chamber_forecast/histogram:
    this partial is the "dashboard cards" heavy surface from the brief's
    Performance section, cached here (not by the caller) so both call sites —
    the dashboard's two cards and /house's chamber summary — get it for free,
    and so a cache hit skips the ChamberForecast lookup and histogram build
    below rather than paying for them regardless. %>
<% cache [ "chamber-card", chamber, model_run ] do %>
  <% chamber_forecast = ChamberForecast.find_by(model_run_id: model_run.id, chamber: chamber) %>
  <% histogram = chamber_forecast && Site::Charts::SeatHistogram.build(chamber_forecast) %>
  <div class="rounded-lg border border-slate-200 p-5" data-testid="chamber-card-<%= title.downcase %>">
    <h2 class="font-serif text-xl font-semibold text-slate-900"><%= title %></h2>

    <% if chamber_forecast %>
      <p class="mt-1 text-sm text-slate-600">
        <% leader = chamber_forecast.p_dem_control >= chamber_forecast.p_rep_control ? "Democrats" : "Republicans" %>
        <% leader_probability = [ chamber_forecast.p_dem_control, chamber_forecast.p_rep_control ].max %>
        <%= leader %> favored to control &mdash; <%= Site::Format.x_in_100(leader_probability) %> simulations.
      </p>

      <div class="mt-3 flex items-baseline gap-4">
        <span class="text-2xl font-bold text-blue-700">D <%= Site::Format.percent(chamber_forecast.p_dem_control) %></span>
        <span class="text-2xl font-bold text-red-700">R <%= Site::Format.percent(chamber_forecast.p_rep_control) %></span>
      </div>

      <% if house %>
        <%= render "shared/house_error_note" %>
      <% end %>

      <div class="mt-4">
        <%= render "races/seat_histogram", payload: histogram, title: title %>
      </div>
    <% else %>
      <p class="mt-2 text-sm text-slate-500" data-testid="chamber-card-empty">No forecast yet.</p>
    <% end %>
  </div>
<% end %>
