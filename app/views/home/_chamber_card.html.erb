<%# locals: model_run (a succeeded ModelRun — callers only render this partial
    once one exists), chamber ("senate"/"house"), title, house (boolean).
    Self-contained rather than taking a precomputed chamber_forecast/histogram:
    this partial is the "dashboard cards" heavy surface from the brief's
    Performance section, cached here (not by the caller) so both call sites —
    the dashboard's two cards and /house's chamber summary — get it for free,
    and so a cache hit skips the ChamberForecast lookup and histogram build
    below rather than paying for them regardless. %>
<% cache [ "chamber-card", chamber, model_run ] do %>
  <% chamber_forecast = ChamberForecast.find_by(model_run_id: model_run.id, chamber: chamber) %>
  <% histogram = chamber_forecast && Site::Charts::SeatHistogram.build(chamber_forecast) %>
  <div class="rounded-lg border border-slate-200 p-5" data-testid="chamber-card-<%= title.downcase %>">
    <%# A tracked label rather than a serif heading: on a card whose whole job
        is the two probabilities below it, "Senate" is the caption and the
        numbers are the headline.

        But a label still has to be findable. At 11px in slate-500 this was
        smaller and paler than the 14px sentence underneath it, which inverts
        the thing it is supposed to do — the eye landed on the body and found
        the label second. 12px at slate-700 keeps it subordinate to the
        figures without making it something you have to hunt for. %>
    <h2 class="eyebrow text-xs text-slate-700"><%= title %></h2>

    <% if chamber_forecast %>
      <p class="mt-1 text-sm text-slate-600">
        <% leader = chamber_forecast.p_dem_control >= chamber_forecast.p_rep_control ? "Democrats" : "Republicans" %>
        <% leader_probability = [ chamber_forecast.p_dem_control, chamber_forecast.p_rep_control ].max %>
        <%= leader %> favored to control &mdash; <%= Site::Format.x_in_100(leader_probability) %> simulations.
      </p>

      <%# The figure, set in three pieces: a tracked party letter, the numeral
          at full size, and the unit small and dimmed. "46" is the thing being
          read; "%" only says what kind of number it is, and setting them at
          one size gives the unit equal billing with the measurement.

          aria-label carries the whole value through Site::Format.percent, so
          the split is purely visual — a screen reader hears "Democrats 46%",
          not the three fragments. %>
      <div class="mt-3 flex items-baseline gap-6" data-testid="chamber-probabilities">
        <span class="flex items-baseline gap-1.5 text-blue-700"
              aria-label="Democrats <%= Site::Format.percent(chamber_forecast.p_dem_control) %>">
          <span class="font-figure text-[11px] font-bold tracking-[0.18em]" aria-hidden="true">D</span>
          <span class="font-figure text-3xl font-bold tracking-tighter" aria-hidden="true"><%= Site::Format.percent_value(chamber_forecast.p_dem_control) %></span>
          <span class="font-figure text-sm font-bold opacity-45" aria-hidden="true">%</span>
        </span>
        <span class="flex items-baseline gap-1.5 text-red-700"
              aria-label="Republicans <%= Site::Format.percent(chamber_forecast.p_rep_control) %>">
          <span class="font-figure text-[11px] font-bold tracking-[0.18em]" aria-hidden="true">R</span>
          <span class="font-figure text-3xl font-bold tracking-tighter" aria-hidden="true"><%= Site::Format.percent_value(chamber_forecast.p_rep_control) %></span>
          <span class="font-figure text-sm font-bold opacity-45" aria-hidden="true">%</span>
        </span>
      </div>

      <div class="mt-4">
        <%= render "races/seat_histogram", payload: histogram, title: title %>
      </div>

      <%# After the chart, not before it: this is a footnote about the figure,
          and wedged between the probability and the histogram it broke the
          card's single idea in two. %>
      <% if house %>
        <%= render "shared/house_error_note" %>
      <% end %>
    <% else %>
      <p class="mt-2 text-sm text-slate-500" data-testid="chamber-card-empty">No forecast yet.</p>
    <% end %>
  </div>
<% end %>
