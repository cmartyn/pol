<% content_for :title, "535 — 2026 midterms forecast" %>

<%= render layout: "shared/headline_row", locals: { source: "homepage" } do %>
  <h1 class="font-serif text-3xl font-semibold text-slate-900">2026 midterms forecast</h1>
  <%= render "shared/as_of", time: @latest_run&.started_at %>
<% end %>

<%= render "home/corpus_note", note: @corpus_note if @corpus_note.visible? %>

<% if @latest_run.nil? %>
  <p class="mt-8 rounded-lg border border-slate-200 bg-slate-50 p-6 text-slate-600" data-testid="dashboard-empty">
    No forecast run has completed yet. Once one has, the Senate and House pictures will appear here.
  </p>
<% else %>
  <div class="mt-6 grid gap-6 sm:grid-cols-2" data-testid="chamber-cards">
    <%= render "home/chamber_card", model_run: @latest_run, chamber: "senate", title: "Senate", house: false, map: true, linked: true %>
    <%= render "home/chamber_card", model_run: @latest_run, chamber: "house", title: "House", house: true, map: true, linked: true %>
  </div>
<% end %>

<section class="mt-10 border-t border-slate-200 pt-6" data-testid="national-environment">
  <h2 class="font-serif text-xl font-semibold text-slate-900">National environment</h2>
  <%= each_variant do |variant| %>
  <% environment = variant == :incl_internals ? @national_environment_incl : @national_environment %>
  <% if environment.polled? %>
    <p class="mt-1 text-lg text-slate-800">
      Generic ballot:
      <span class="font-figure font-bold tracking-tight <%= environment.mean_margin.positive? ? "text-blue-700" : "text-red-700" %>">
        <%= Site::Format.margin(environment.mean_margin, side_a_party: "dem", side_b_party: "rep") %>
      </span>
      <%# Its own line on a phone. Inline, the parenthetical broke after
          "45-day" and the second line took the text-lg line height. %>
      <span class="text-sm text-slate-500 max-sm:block">
        (<%= pluralize(environment.poll_count, "poll") %>, <%= environment.window_days %>-day window, as of today)
      </span>
    </p>
  <% else %>
    <p class="mt-1 text-slate-500" data-testid="national-environment-empty">No generic-ballot polling in the current window.</p>
  <% end %>
  <% end %>
</section>

<% if @movers.present? %>
  <section class="mt-10 border-t border-slate-200 pt-6" data-testid="movers-section">
    <h2 class="font-serif text-xl font-semibold text-slate-900">Movers</h2>
    <p class="mt-1 text-sm text-slate-500">Biggest shifts in Democratic win probability, this run vs. about a week ago.</p>
    <%# The race and the delta are one fact. space-between parked them at
        opposite edges of a wide row, so the landing probability could not
        be read with the name. From sm up the rows share one grid (subgrid),
        so every delta starts at the same x a short gap after the longest
        name, and the column reads down. On a phone the delta sits under the
        name in every row, not only in the rows whose name was long enough
        to wrap. %>
    <ul class="mt-4 max-w-prose divide-y divide-slate-100 sm:grid sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-x-6">
      <% @movers.each do |mover| %>
        <li class="flex flex-col gap-y-0.5 py-2 text-sm sm:col-span-2 sm:grid sm:grid-cols-subgrid sm:items-baseline" data-testid="mover-row">
          <%= link_to mover.race.name, race_path(mover.race.slug), class: "font-medium text-slate-900 hover:text-amber-700" %>
          <%# Only the magnitude goes in the figure face — "pts toward Dem" is
              prose, and setting the whole phrase in mono reads as a log line.
              The landing probability is the number the delta moved to, so a
              reader does not have to open the race to know where it stands. %>
          <span class="whitespace-nowrap font-semibold <%= mover.direction == :dem ? "text-blue-700" : "text-red-700" %>">
            <span class="font-figure font-bold tracking-tight"><%= number_with_precision(mover.delta_pp.abs, precision: 1) %></span>
            pts toward <%= mover.direction == :dem ? "Dem" : "Rep" %>
            <span class="font-normal text-slate-600">· now <%= Site::Format.percent(mover.latest_p_dem_win) %> Dem</span>
          </span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="mt-10 border-t border-slate-200 pt-6" data-testid="dashboard-dispatches">
  <%# The same measure as the teasers under it, so "All dispatches" ends
      where the column ends. Across the full container it sat about 600px
      past the last line of text it belongs to. %>
  <div class="flex max-w-prose items-baseline justify-between gap-4">
    <h2 class="font-serif text-xl font-semibold text-slate-900">Latest dispatches</h2>
    <%= link_to "All dispatches →", dispatches_path, class: "text-sm font-medium text-amber-700 hover:text-amber-800" %>
  </div>
  <div class="mt-2 max-w-prose">
    <% if @dispatches.any? %>
      <%= render partial: "dispatches/dispatch", collection: @dispatches, as: :dispatch, locals: { truncate: 200 } %>
    <% else %>
      <p class="text-slate-500" data-testid="dispatches-empty">No dispatches published yet.</p>
    <% end %>
  </div>
</section>

<%# Below the forecast — the chamber pictures, what moved, the dispatches —
    and outside the cached chamber cards. A form inside either card would
    duplicate, and a cache hit would skip rendering it. %>
<div class="mt-10">
  <%= render "shared/subscription_form", source: "homepage", layout: "band" %>
</div>
