<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "535 — 2026 midterms forecast" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="<%= content_for(:description) || "An agent-powered forecast of the 2026 U.S. Senate and House elections: correlated Monte Carlo simulation, live polling, transparent methodology." %>">
    <link rel="canonical" href="<%= content_for(:canonical_url) || canonical_url %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="535">
    <meta name="mobile-web-app-capable" content="yes">

    <%= render "shared/fonts" %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# The SVG is the real mark and scales to any tab; the PNG is the fallback
        for browsers that don't take SVG favicons. apple-touch-icon is its own
        file rather than icon.png because iOS applies its own rounded mask —
        that variant is full-bleed with the art inset, so the mask has nothing
        to cut off. %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# PostHog frontend tracking — pageviews, session replay, and client-side events.
        Only rendered when the public token is configured. %>
    <% if Rails.configuration.x.posthog_project_token.present? %>
    <script>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('<%= j Rails.configuration.x.posthog_project_token %>', {
        api_host: '<%= ENV.fetch("POSTHOG_HOST", "https://us.i.posthog.com") %>',
        person_profiles: 'identified_only'
      });
    </script>
    <% end %>
  </head>

  <body class="min-h-screen bg-white text-slate-900 antialiased [font-variant-numeric:tabular-nums]">
    <a href="#main" class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:left-3 focus-visible:top-3 focus-visible:z-50 focus-visible:rounded focus-visible:bg-slate-900 focus-visible:px-3 focus-visible:py-2 focus-visible:text-white">
      Skip to content
    </a>

    <header class="border-b border-slate-200">
      <div class="container mx-auto flex flex-wrap items-center justify-between gap-x-8 gap-y-3 px-5 py-4">
        <%# The stamp is beside the wordmark rather than inside the link: it
            dates the forecast, and a timestamp that navigates home when you
            click it is a small lie about what it is. %>
        <div class="flex items-baseline gap-2.5 shrink-0">
          <%= link_to "535", root_path, class: "font-serif text-2xl font-semibold tracking-tight text-slate-900" %>
          <% if (run = latest_model_run) %>
            <span class="hidden font-figure text-[10px] tracking-tight text-slate-400 sm:inline" data-testid="header-updated">
              <%= Site::Format.last_updated(run.started_at) %>
            </span>
          <% end %>
        </div>

        <nav class="flex flex-wrap items-center gap-x-1 gap-y-1 text-sm font-medium" aria-label="Primary">
          <%= nav_link "Dashboard", root_path %>
          <%= nav_link "Senate", senate_path %>
          <%= nav_link "House", house_path %>
          <%= nav_link "Dispatches", dispatches_path %>
          <%= nav_link "Pollsters", pollsters_path %>
          <%= nav_link "Methodology", methodology_path %>
          <%= nav_link "About", about_path %>
        </nav>

        <%# The internals toggle. Off is the published forecast — independent
            polling only; on is the same model with partisan-sponsored polls
            included, adjusted and down-weighted. Every number on the site
            follows it (both variants are in the page; CSS shows one), so it
            lives in the header, not on any one chart. Hidden when JS is off:
            a control that could never do anything is worse than none, and
            the no-JS reader already has the published view. %>
        <label class="hidden items-center gap-2 text-xs text-slate-600 [html[data-internals]_&]:flex"
               data-controller="internals-toggle" data-testid="internals-toggle"
               title="Include polls from partisan-aligned sponsors, adjusted toward the non-sponsor party and down-weighted — see Methodology.">
          <input type="checkbox" class="peer sr-only" data-internals-toggle-target="switch"
                 data-action="internals-toggle#toggle">
          <span class="relative h-4 w-7 shrink-0 rounded-full bg-slate-300 transition-colors peer-checked:bg-amber-600 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-amber-600
                       after:absolute after:left-0.5 after:top-0.5 after:h-3 after:w-3 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-3"></span>
          <span class="whitespace-nowrap">Partisan internals</span>
        </label>
      </div>
    </header>

    <main id="main" class="container mx-auto px-5 py-10">
      <% if flash[:notice].present? %>
        <p class="mb-6 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert].present? %>
        <p class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><%= flash[:alert] %></p>
      <% end %>
      <%= yield %>
    </main>

    <footer class="mt-24 border-t border-slate-200 py-10 text-sm text-slate-500">
      <div class="container mx-auto grid gap-8 px-5 lg:grid-cols-[minmax(0,1fr)_minmax(280px,420px)]">
        <div class="max-w-2xl">
          <p>
            535 is an autonomous forecast newsroom — agents write from the numbers, an editor reviews.
            No secret sauce: every parameter this model uses is on the
            <%= link_to "methodology page", methodology_path, class: "font-medium text-amber-700 hover:text-amber-800" %>.
          </p>
          <p class="mt-2 text-xs text-slate-400">
            A project of <%= link_to "Appmakey LLC", "https://appmakey.com", class: "font-medium text-amber-700 hover:text-amber-800",
                                     target: "_blank", rel: "noopener" %>.
            <%= link_to "Privacy", privacy_path, class: "ml-2 font-medium text-amber-700 hover:text-amber-800" %>
          </p>
        </div>
        <%= render "shared/subscription_form", source: "footer", compact: true %>
      </div>
    </footer>
  </body>
</html>
